# ==============================================================================
# SERVER
# ==============================================================================
server <- function(input, output, session) {
  
  # Descarga del CSV
  output$descargar_csv <- downloadHandler(
    filename = function() {
      paste0("acled_ecuador_maestro_", format(Sys.Date(), "%Y%m%d"), ".csv")
    },
    content = function(file) {
      readr::write_csv(datos |> mutate(across(where(is.factor), as.character)), file)
    }
  )
  
  # ---------- Reactives comunes ----------
  datos_temporal <- reactive({
    d <- datos
    if (!is.null(input$temporal_anios)) {
      d <- d |> filter(year >= input$temporal_anios[1], year <= input$temporal_anios[2])
    }
    if (!is.null(input$temporal_tipo) && input$temporal_tipo != "Todos") {
      d <- d |> filter(as.character(disorder_type) == input$temporal_tipo)
    }
    d
  })
  
  datos_geo <- reactive({
    d <- datos
    if (!is.null(input$geo_anio) && input$geo_anio != "Todos") {
      d <- d |> filter(year == as.integer(input$geo_anio))
    }
    if (!is.null(input$geo_tipo) && input$geo_tipo != "Todos") {
      d <- d |> filter(as.character(event_type) == input$geo_tipo)
    }
    d
  })
  
  datos_actores_base <- reactive({
    d <- datos
    if (!is.null(input$actores_anios)) {
      d <- d |> filter(year >= input$actores_anios[1], year <= input$actores_anios[2])
    }
    if (!is.null(input$actores_provincia) && input$actores_provincia != "Todas") {
      d <- d |> filter(as.character(admin1) == input$actores_provincia)
    }
    d
  })
  
  # Reset filtros
  observeEvent(input$btn_reset_temporal, {
    updateSliderInput(session, "temporal_anios", value = c(min(datos$year), max(datos$year)))
    updateSelectInput(session, "temporal_tipo", selected = "Todos")
  })
  observeEvent(input$btn_reset_geo, {
    updateSelectInput(session, "geo_anio", selected = "Todos")
    updateSelectInput(session, "geo_tipo", selected = "Todos")
  })
  observeEvent(input$btn_reset_actores, {
    updateSliderInput(session, "actores_anios", value = c(min(datos$year), max(datos$year)))
    updateSelectInput(session, "actores_provincia", selected = "Todas")
    updateRadioButtons(session, "g1_actor_col", selected = "actor1")
    updateSelectInput(session, "g1_actor_sel", selected = "Todos")
    updateRadioButtons(session, "g2_tipo_col", selected = "assoc_actor_1_tipo")
  })
  
  # ==========================================================================
  # INICIO 
  # ==========================================================================
  output$g1_home_chips <- renderUI({
    tipos <- levels(datos$disorder_type)
    tagList(
      div(class = "chip-wrap",
          tags$span(class = "chip-btn-all", id = "chip_all_home_g1", onclick = "activarTodosHomeG1()", "Todos"),
          lapply(seq_along(tipos), function(i) {
            color <- paleta_disorder[[tipos[i]]]
            tags$span(class = "chip-btn chip-on", id = paste0("chip_home_g1_", i), style = paste0("background:", color, "; border-color:", color, ";"), `data-tipo` = tipos[i], `data-color` = color, onclick = paste0("toggleChipHomeG1(this, '", tipos[i], "')"), tipos[i])
          })
      ),
      tags$script(HTML(paste0("
        var homeG1Activos = new Set(", jsonlite::toJSON(tipos, auto_unbox = FALSE), ");
        function toggleChipHomeG1(el, tipo) {
          if (homeG1Activos.has(tipo)) {
            if (homeG1Activos.size <= 1) return;
            homeG1Activos.delete(tipo);
            el.classList.remove('chip-on'); el.style.background = '#f8f9fb'; el.style.borderColor = '#eaecf0'; el.style.color = '#546e7a';
          } else {
