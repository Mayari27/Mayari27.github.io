      count(fuente_principal, assoc_actor_1_tipo) |>
      group_by(fuente_principal) |>
      mutate(porcentaje = n / sum(n) * 100) |>
      ungroup()
    
    # Crear una paleta dinámica
    paleta_medios_actor <- hacer_paleta_dinamica(df_plot, assoc_actor_1_tipo, c(col_indigo, col_teal, col_coral, col_amber, col_magenta))
    
    # Gráfico con ajuste de texto en el eje Y
    p <- ggplot(df_plot, aes(x = fuente_principal, y = porcentaje, fill = assoc_actor_1_tipo, text = paste0(fuente_principal, "<br>", assoc_actor_1_tipo, ": ", round(porcentaje, 1), "%"))) +
      geom_bar(stat = "identity", position = "fill") +
      scale_y_continuous(labels = scales::percent_format(scale = 1)) +
      scale_fill_manual(values = paleta_medios_actor, name = "Tipo de actor") +
      labs(y = "Porcentaje de la cobertura", x = NULL) +
      coord_flip() +
      tema_acled() +
      theme(
        axis.text.y = element_text(size = 11) # Hacemos el texto del eje Y un poco más grande para que no choque
      )
    
    # Ajustamos los márgenes del gráfico para que los nombres largos quepan
    ggplotly(p, tooltip = "text") |>
      layout(margin = list(l = 200)) |>
      plotly_solo_tooltip()
  })
  
}

