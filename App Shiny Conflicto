ajustar_mapa_ecuador <- function(mapa, datos_mapa = NULL) {
  if (!is.null(datos_mapa) && nrow(datos_mapa)) {
    lon <- datos_mapa$longitude[is.finite(datos_mapa$longitude)]
    lat <- datos_mapa$latitude[is.finite(datos_mapa$latitude)]
    if (length(lon) && length(lat)) {
      return(
        mapa |>
          fitBounds(
            lng1 = min(lon, na.rm = TRUE),
            lat1 = min(lat, na.rm = TRUE),
            lng2 = max(lon, na.rm = TRUE),
            lat2 = max(lat, na.rm = TRUE)
          )
      )
    }
  }
  
  mapa |>
    fitBounds(lng1 = -92.2, lat1 = -5.2, lng2 = -75.0, lat2 = 1.8)
}

