render_texto_narrativo <- function(texto) {
  if (is.null(texto)) return(NULL)
  if (!is.character(texto)) return(texto)
  txt <- paste(texto, collapse = " ")
  txt <- htmltools::htmlEscape(txt)
  txt <- gsub("\\*\\*([^*]+)\\*\\*", "<strong>\\1</strong>", txt, perl = TRUE)
  txt <- gsub("\\*([^*]+)\\*", "<em>\\1</em>", txt, perl = TRUE)
  txt <- gsub("\n", "<br>", txt, fixed = TRUE)
  HTML(txt)
}

