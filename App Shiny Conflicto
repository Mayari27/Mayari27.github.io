lighten_col <- function(hex, amount = 0.4) {
  v <- col2rgb(hex) / 255
  v <- v + (1 - v) * amount
  rgb(v[1], v[2], v[3])
}

hacer_paleta_dinamica <- function(datos, columna, colores = paleta_app) {
  niveles <- datos |>
    pull({{ columna }}) |>
    as.character() |>
    na.omit() |>
    unique() |>
    sort()
  if (!length(niveles)) return(setNames(character(), character()))
  setNames(colorRampPalette(colores)(length(niveles)), niveles)
}

