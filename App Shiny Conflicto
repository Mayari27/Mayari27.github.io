tema_acled <- function(base_size = 12) {
  theme_minimal(base_size = base_size) +
    theme(
      plot.background = element_rect(fill = col_tarjeta, color = NA),
      panel.background = element_rect(fill = col_tarjeta, color = NA),
      panel.grid.major = element_line(color = col_borde, linewidth = 0.45),
      panel.grid.minor = element_blank(),
      plot.title = element_text(color = col_navy, face = "bold", size = base_size + 3),
      plot.subtitle = element_text(color = col_gris, size = base_size, margin = margin(b = 8)),
      plot.caption = element_text(color = col_gris, size = base_size - 2, hjust = 0),
      axis.title = element_text(color = col_texto, face = "bold"),
      axis.text = element_text(color = col_gris),
      legend.title = element_text(color = col_texto, face = "bold"),
      legend.text = element_text(color = col_texto),
      strip.text = element_text(color = col_navy, face = "bold"),
      plot.margin = margin(12, 14, 12, 12)
