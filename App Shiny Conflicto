          }
          Shiny.setInputValue('home_g1_activos', Array.from(homeG1Activos), {priority: 'event'});
        }
        function activarTodosHomeG1() {
          document.querySelectorAll('[id^=chip_home_g1_]').forEach(function(el) {
            homeG1Activos.add(el.dataset.tipo); el.classList.add('chip-on'); el.style.background = el.dataset.color; el.style.borderColor = el.dataset.color; el.style.color = '#fff';
          });
          Shiny.setInputValue('home_g1_activos', Array.from(homeG1Activos), {priority: 'event'});
        }
      ")))
    )
  })
  
