tabla_clasificacion_eventos <- function(datos, paleta_disorder) {
  estructura <- datos |>
    distinct(disorder_type, event_type, sub_event_type) |>
    mutate(
      disorder_type = as.character(disorder_type),
      event_type = as.character(event_type),
      sub_event_type = as.character(sub_event_type)
    ) |>
    arrange(disorder_type, event_type, sub_event_type)
  
  filas <- tagList()
  
  for (disorder in unique(estructura$disorder_type)) {
    bloque_disorder <- estructura |> filter(disorder_type == disorder)
    color <- paleta_disorder[[disorder]]
    if (is.null(color) || is.na(color)) color <- col_teal
    color_disorder_bg <- lighten_col(color, 0.66)
    color_event_bg <- lighten_col(color, 0.82)
    color_sub_bg <- lighten_col(color, 0.95)
    
    primer_disorder <- TRUE
    for (evento in unique(bloque_disorder$event_type)) {
      bloque_evento <- bloque_disorder |> filter(event_type == evento)
      primer_evento <- TRUE
      
      for (subevento in bloque_evento$sub_event_type) {
        celdas <- list()
        
        if (primer_disorder) {
          celdas <- append(celdas, list(
            tags$td(
              rowspan = nrow(bloque_disorder),
              class = "flow-cell flow-disorder",
              style = glue("background:{color_disorder_bg};color:{color};"),
              disorder
            )
          ))
          primer_disorder <- FALSE
        }
        
        if (primer_evento) {
          celdas <- append(celdas, list(
            tags$td(
              rowspan = nrow(bloque_evento),
              class = "flow-cell flow-event",
              style = glue("background:{color_event_bg};color:{color};"),
              evento
            )
          ))
          primer_evento <- FALSE
        }
        
        celdas <- append(celdas, list(
          tags$td(
            class = "flow-cell flow-sub",
            style = glue("background:{color_sub_bg};"),
            subevento
          )
        ))
        filas <- tagAppendChildren(filas, do.call(tags$tr, celdas))
      }
    }
  }
  
  div(
    class = "flow-accordion",
    tags$button(
      type = "button",
      class = "flow-toggle collapsed",
      `data-bs-toggle` = "collapse",
      `data-bs-target` = "#clasificacion_eventos",
      `aria-expanded` = "false",
      `aria-controls` = "clasificacion_eventos",
      bsicons::bs_icon("diagram-3"),
      tags$span("Ver estructura de clasificacion de eventos"),
      bsicons::bs_icon("chevron-down", class = "flow-chevron")
    ),
    div(
      id = "clasificacion_eventos",
      class = "collapse",
      div(
        class = "flow-panel",
        div(class = "flow-intro", "Relacion jerarquica entre las tres variables principales de clasificacion: categoria macro, tipo de evento y subtipo especifico registrado por ACLED."),
        div(
          class = "flow-table-wrap",
          tags$table(
            class = "flow-table",
            tags$thead(
              tags$tr(
                tags$th("DISORDER_TYPE"),
                tags$th("EVENT_TYPE"),
                tags$th("SUB_EVENT_TYPE")
              )
            ),
            tags$tbody(filas)
          )
        )
      )
    )
  )
}

